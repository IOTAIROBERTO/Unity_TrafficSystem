# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db

# Unity3D generated
sysinfo.txt
*.stackdump
ExportedObj/
.consulo/
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Internal working documentation, not for the public repo
/Docs/

# Package Manager writes imported samples here; they duplicate Samples~ in the package
/Assets/Samples/
/Assets/Samples.meta

# Generated by the sample scene builder and by editor screenshots
/Assets/TrafficSystem-SampleScene/
/Assets/TrafficSystem-SampleScene.meta
/Assets/Screenshots/
/Assets/Screenshots.meta

# Generated by the city builder
/Assets/TrafficSystem-City/
/Assets/TrafficSystem-City.meta
